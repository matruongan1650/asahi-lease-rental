# XServer (Apache) — API ルーティング + SPA フォールバック
# ※ ドメイン直下 (public_html 直下) に配置する想定。サブディレクトリ配置時は RewriteBase を調整。

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 拡張子なしの API パスを PHP にルーティング（クエリ文字列は保持）
  RewriteRule ^api/store/?$  api/store.php  [L,QSA]
  RewriteRule ^api/sync/?$   api/sync.php   [L,QSA]
  RewriteRule ^api/health/?$ api/health.php [L,QSA]
  RewriteRule ^api/mail/?$   api/mail.php   [L,QSA]
  RewriteRule ^api/notify-customers/?$ api/notify-customers.php [L,QSA]
  RewriteRule ^api/upload/?$ api/upload.php [L,QSA]

  # /api/・/assets/ 配下と実在ファイル/ディレクトリ以外は index.html へ（React Router 用）
  # （/assets/ を除外: 削除済みの旧バンドルに HTML を返さず素直に 404 にする）
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# config.php への直接アクセスを拒否（保険。PHP は実行され中身は出力されないが念のため）
<Files "config.php">
  Require all denied
</Files>

# キャッシュ制御:
#   - index.html は常にサーバーへ再検証（デプロイ直後から新バンドルが読まれる。古い画面が残らない）
#   - ハッシュ付きアセット(js/css)は内容が変わればファイル名も変わるため長期キャッシュでOK
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
