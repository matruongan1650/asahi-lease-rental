{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=4000 --host=0.0.0.0 --strictPort",
    "server": "tsx server/dev.ts",
    "server:watch": "tsx watch server/dev.ts",
    "clean": "rm -rf dist",
    "clean:staff": "rm -rf dist-staff",
    "lint": "tsc --noEmit",
    "build": "npm run lint && vite build",
    "build:staff": "npm run lint && vite build --config vite.staff.config.ts && cp dist-staff/index.staff.html dist-staff/index.html",
    "preview": "vite preview",
    "deploy": "npm run clean && npm run build && bash deploy_vps.sh",
    "deploy:xserver": "npm run clean && npm run build && python3 deploy_xserver.py",
    "android:add": "npm run clean:staff && npm run build:staff && cap add android",
    "android:sync": "npm run clean:staff && npm run build:staff && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@google/genai": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@types/react-datepicker": "^6.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
